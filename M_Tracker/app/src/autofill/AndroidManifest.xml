<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only compiled into the optional "autofill" build. The standard build contains NO notification-reading code. -->
    <application>
        <service
            android:name="com.mtracker.app.PaymentNotificationListener"
            android:exported="true"
            android:label="Arthak payment reminders"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
